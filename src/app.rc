#include "resource.h"
#include "version.h"
#include <winver.h>
IDI_CODEX_METER ICON "codex-meter.ico"
1 VERSIONINFO
 FILEVERSION METER_FILE_VERSION
 PRODUCTVERSION METER_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Codex Meter contributors\0"
            VALUE "FileDescription", "Codex Meter - Windows quota widget\0"
            VALUE "FileVersion", METER_VERSION "\0"
            VALUE "InternalName", "codex_meter\0"
            VALUE "OriginalFilename", "codex_meter.exe\0"
            VALUE "ProductName", "Codex Meter\0"
            VALUE "ProductVersion", METER_VERSION "\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Codex Meter contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
